{
  "name": "polioverlayui",
  "version": "1.0.3",
  "description": "PoliGame Overlay UI - Electron Application",
  "main": "main.js",
  "scripts": {
    "dev": "vite & electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "install-acrylic": "node -e \"require('child_process').execSync('npm install electron-acrylic-window --save', {stdio: 'inherit', env: {...process.env, npm_config_msvs_version: '2022'}})\""
  },
  "build": {
    "appId": "com.poligame.overlay",
    "productName": "PoliGame Overlay",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "**/*",
      "!src",
      "!*.md",
      "!node_modules",
      "!overlay-ui",
      "!*.config.js",
      "!tsconfig*.json"
    ],
    "extraFiles": [
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "convex": "^1.31.0",
    "electron-acrylic-window": "^0.5.11",
    "electron-store": "^10.0.0",
    "better-sqlite3": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7",
    "lucide-react": "^0.300.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "@base-ui/react": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18"
  }
}
